#!/usr/bin/env bash
# Script to modify /etc/hosts for custom resolutions

# Ensure /etc/hosts is modified only if necessary
if ! grep -q '127\.0\.0\.2 localhost' /etc/hosts; then
    # Update localhost to resolve to 127.0.0.2
    sudo sed -i 's/127\.0\.0\.1/127\.0\.0\.2/' /etc/hosts
fi

# Add facebook.com to resolve to 8.8.8.8 if not already present
if ! grep -q '8.8.8.8 facebook.com' /etc/hosts; then
    echo '8.8.8.8 facebook.com' | sudo tee -a /etc/hosts > /dev/null
fi

# Inform the user that the configuration is updated
echo "Configuration updated. Current /etc/hosts file:"
cat /etc/hosts
