#!/usr/bin/env bash
# Script to configure the /etc/hosts file with specific IP resolutions

# Update localhost to resolve to 127.0.0.2
sudo sed -i '/localhost/ s/127\.0\.0\.1/127.0.0.2/' /etc/hosts

# Add facebook.com to resolve to 8.8.8.8 if not already present
if ! grep -q "8.8.8.8 facebook.com" /etc/hosts; then
    echo "8.8.8.8 facebook.com" | sudo tee -a /etc/hosts > /dev/null
fi

echo "Configuration updated. Current /etc/hosts file:"
cat /etc/hosts
